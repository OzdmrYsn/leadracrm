# Ortam değişkenleri. Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# .env.local depoya girmez. Gizli anahtarları hiçbir zaman bu dosyaya (ya da koda) yazmayın.

# --- Veritabanı ---
# Yerel geliştirme: `bash scripts/db.sh reset` ile kurulan veritabanı (şifresizdir, yalnız bu makineden erişilir).
# Supabase: Project Settings > Database > Connection string > "Transaction pooler" adresi (şifreli; gizlidir).
DATABASE_URL=postgres://postgres@127.0.0.1:54329/ysccrm

# --- Supabase (kimlik doğrulama, gerçek zaman, dosyalar) --- henüz bağlı değil
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnız sunucuda kullanılır; tarayıcıya asla gönderilmez.
SUPABASE_SERVICE_ROLE_KEY=

# --- Kanallar ---
# Kanal anahtarlarını (ör. Telegram bot belirteci) çalışma alanı yöneticisi uygulamanın içinden girer; burada tutulmaz.
# Anahtarlar veritabanında APP_SECRET ile şifrelenir. Gerçek kanallar için APP_URL herkese açık bir https adresi olmalıdır.
# Telegram API adresi (isteğe bağlı). Verilmezse üretimde https://api.telegram.org, geliştirmede yerel taklit kullanılır.
TELEGRAM_API_URL=

# --- E-posta (Resend) ---
# Doğrulama, şifre sıfırlama ve davet iletileri. İkisi de tanımlıysa Resend'in API'si kullanılır; değilse
# geliştirmede iletiler yerel giden kutusuna düşer. Üretimde bunlar yoksa kayıt ve giriş kapalı kalır.
RESEND_API_KEY=
# Gönderen adres; alan adınız Resend'de doğrulanmış olmalı. Örn. LeadraCRM <bildirim@ornek.com>
MAIL_FROM=

# --- İş kuyruğu (Inngest) --- henüz bağlı değil
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Uygulama sırrı ve adresi ---
# Dış hizmet anahtarlarını (ör. Google yenileme anahtarı) veritabanında şifrelemek için. En az 32 karakter, rastgele.
# Üretimde zorunludur; yoksa Google bağlantısı kapalı kalır. Değiştirirseniz bağlı Google hesapları yeniden bağlanmalıdır.
APP_SECRET=
# Uygulamanın dışarıdan görünen adresi (ör. https://ornek.com). Google yönlendirme ve bildirim adresleri buna göre kurulur.
APP_URL=
# Zamanlanmış işleri çağıranın göndereceği sır: "Authorization: Bearer <CRON_SECRET>". Üretimde zorunludur.
CRON_SECRET=

# --- Google hesabıyla tablo bağlama --- henüz bağlı değil (anahtar yokken geliştirmede yerel taklit çalışır)
# Google Cloud > APIs & Services > Credentials > OAuth client ID (Web application).
# Yetkili yönlendirme adresi: <APP_URL>/api/google/callback · Açılacak API'ler: Google Drive, Google Sheets, Google Picker.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dosya seçici için tarayıcı anahtarı (API key; yalnız Picker API'ye ve sitenizin adresine kısıtlayın) ve proje numarası.
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# --- Abonelik --- ödeme sağlayıcısı henüz bağlı değil (geliştirmede yerel taklit çalışır)
# Koltuk başına aylık tutar, küçük birimde (ör. 49900 = 499,00). Verilmezse ekranda "geçici fiyat" yazar.
BILLING_SEAT_MONTHLY_MINOR=
# Para birimi (ISO 4217). Varsayılan TRY.
BILLING_CURRENCY=
